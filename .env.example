# Copy to .env and adjust. Only PW_DB_PASSWORD is required.

# --- Database (MariaDB 11) ---
PW_DB_PASSWORD=change-me-to-a-long-random-password
# PW_DB_NAME=pulsewatch
# PW_DB_USER=pulsewatch
# PW_DB_BUFFER_POOL=256M

# --- App ---
# Public URL users type in the browser (used for links in mails, OIDC callbacks and passkeys). Use https:// behind a reverse proxy.
PW_BASE_URL=http://localhost:3000
# PW_PUBLIC_PORT=3000
# Set to true when a reverse proxy in front sets X-Forwarded-For (needed for correct client IPs and rate limits).
# PW_TRUST_PROXY=false
# Key for encrypting secrets at rest. Generate one with: openssl rand -base64 32
# Left empty, a key file is generated in the data volume (back it up with the database!).
PW_SECRET_KEY=
# PW_LOG_LEVEL=info

# --- Process roles: all (default) | api | worker. Split them with: PW_ROLE=api docker compose --profile split up -d
# PW_ROLE=all

# --- Security ---
# allow-private (default, monitoring internal hosts works) or public-only
# PW_SSRF_MODE=allow-private
# Comma separated IPs/CIDRs: PW_SSRF_ALLOW exempts addresses in public-only mode, PW_SSRF_DENY blocks addresses always.
# PW_SSRF_ALLOW=
# PW_SSRF_DENY=
# Bearer token that protects /metrics (Prometheus). Without it only administrators can read it.
# PW_METRICS_TOKEN=

# --- Email (digests, reports, status page subscriptions) ---
# PW_SMTP_HOST=
# PW_SMTP_PORT=587
# PW_SMTP_USER=
# PW_SMTP_PASS=
# PW_SMTP_FROM=PulseWatch <pulsewatch@example.com>
# PW_SMTP_SECURE=false

# --- Reliability ---
# URL pinged every minute so an external service can alert when PulseWatch itself is down (e.g. a push monitor URL).
# PW_DEADMAN_URL=
# PW_MAX_CONCURRENCY=200
# PW_RETENTION_RAW_DAYS=14

# --- Tracing (optional OTLP/HTTP endpoint, e.g. http://otel-collector:4318) ---
# PW_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Demo mode: sample monitors and 90 days of fake history (do not use in production) ---
# PW_DEMO=true
# PW_DEMO_PASSWORD=

# --- Remote probe (profile "probe") ---
# PW_SERVER_URL=https://pulsewatch.example.com
# PW_PROBE_TOKEN=
