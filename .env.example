# Copy to .env and adjust. Only PW_DB_PASSWORD is required.

# --- Database (MariaDB 11) ---
PW_DB_PASSWORD=change-me-to-a-long-random-password
# PW_DB_NAME=pulsewatch
# PW_DB_USER=pulsewatch
# PW_DB_BUFFER_POOL=256M

# --- App ---
# Public URL users type in the browser (used for links in mails, OIDC callbacks and passkeys). Use https:// behind a reverse proxy.
PW_BASE_URL=http://localhost:3000
# PW_PUBLIC_PORT=3000
# Address the published port binds to. Use 127.0.0.1 when a reverse proxy runs on the same host.
# PW_BIND=0.0.0.0
# Trust X-Forwarded-For from a reverse proxy (needed for correct client IPs, rate limits and lockouts). Formats:
#   false (default) | the number of proxies in front of the app, e.g. 1 (recommended) | proxy IPs/CIDRs, e.g. 10.0.0.0/8,172.18.0.2
#   true trusts every hop: clients can then forge their address, and the app logs a warning at start.
# PW_TRUST_PROXY=false
# Token that is asked for on the setup page to create the first administrator. Left empty, a one-time token is
# generated on the first start and written to the log (docker compose logs app).
# PW_SETUP_TOKEN=
# IANA time zone (e.g. Europe/Berlin) for day boundaries of rollups, heatmaps, day bars and reports. Default UTC.
# Use the same value for every container. Changing it makes the next start rebuild the daily rollups from the hourly ones.
# PW_TIMEZONE=UTC
# Time a container may take to stop (running checks, notifications, database). Keep it below stop_grace_period (30s) in the compose file.
# PW_SHUTDOWN_GRACE_MS=20000
# Key for encrypting secrets at rest. Generate one with: openssl rand -base64 32
# Left empty, a key file is generated in the data volume (back it up with the database!).
PW_SECRET_KEY=
# PW_LOG_LEVEL=info

# --- Process roles: all (default) | api | worker. Split them with: PW_ROLE=api docker compose --profile split up -d
# PW_ROLE=all

# --- Security ---
# allow-private (default, monitoring internal hosts works) or public-only. Any other value stops the start.
# PW_SSRF_MODE=allow-private
# Comma separated IPs/CIDRs: PW_SSRF_ALLOW exempts addresses in public-only mode, PW_SSRF_DENY blocks addresses always.
# PW_SSRF_ALLOW=
# PW_SSRF_DENY=
# Bearer token that protects /metrics (Prometheus). Without it only administrators can read it.
# PW_METRICS_TOKEN=

# --- Email (digests, reports, status page subscriptions) ---
# PW_SMTP_HOST=
# PW_SMTP_PORT=587
# PW_SMTP_USER=
# PW_SMTP_PASS=
# PW_SMTP_FROM=PulseWatch <pulsewatch@example.com>
# PW_SMTP_SECURE=false

# --- Docker images (the compose file pulls these; see docker-compose.build.yml to build from source) ---
# PW_IMAGE=ghcr.io/pd-codes/pdc-pulsewatch:latest
# PW_PROBE_IMAGE=ghcr.io/pd-codes/pdc-pulsewatch-probe:latest

# --- Reliability ---
# URL pinged every minute so an external service can alert when PulseWatch itself is down (e.g. a push monitor URL).
# PW_DEADMAN_URL=
# PW_MAX_CONCURRENCY=200
# PW_RETENTION_RAW_DAYS=14
# PW_RETENTION_MINUTE_DAYS=60
# PW_RETENTION_HOUR_DAYS=400
# PW_RETENTION_DAY_DAYS=3650
# PW_RETENTION_EVENT_DAYS=365
# PW_RETENTION_AUDIT_DAYS=730

# --- Tracing (optional OTLP/HTTP endpoint, e.g. http://otel-collector:4318) ---
# PW_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Demo mode: sample monitors and 90 days of fake history (do not use in production) ---
# PW_DEMO=true
# PW_DEMO_PASSWORD=

# --- Remote probe (profile "probe") ---
# PW_SERVER_URL=https://pulsewatch.example.com
# PW_PROBE_TOKEN=
